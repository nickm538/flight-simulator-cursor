# Server
PORT=3000
NODE_ENV=production

# Optional: live METARs via aviationweather.gov are used with no key.
# Optional OpenWeather overlay (put the key in Railway Variables):
OPENWEATHER_API_KEY=

# Optional: extra ATC phrasing via OpenAI. The full ATC tree works offline without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Callsign shown to ATC if not set in the UI
DEFAULT_CALLSIGN=Southwest 1847
